# Combined Railway service: CodePlay + WAHA
PORT=3000
NODE_ENV=production

SITE_URL=https://YOUR-CODEPLAY-DOMAIN
GAME_SITE_URL=https://YOUR-VERCEL-APP.vercel.app
SITE_ORIGIN=https://YOUR-CODEPLAY-DOMAIN
PUBLIC_BASE_URL=https://YOUR-CODEPLAY-DOMAIN
CORS_ORIGIN=https://YOUR-CODEPLAY-DOMAIN

ADMIN_PASSWORD=replace-with-a-long-random-secret

WAHA_URL=http://127.0.0.1:3001
WAHA_API_PORT=3001
WAHA_SESSION=default
WHATSAPP_DEFAULT_ENGINE=NOWEB
WAHA_NOWEB_WA_VERSION=auto-web
WAHA_NOWEB_WA_VERSION_FORCE=False
WAHA_AUTO_START_DELAY_SECONDS=5
WAHA_EVENT_WS_ENABLED=true
WAHA_API_KEY=replace-with-a-long-random-waha-api-key
WAHA_WEBHOOK_SECRET=replace-with-a-long-random-waha-webhook-secret
WAHA_PAIRING_PASSWORD=replace-with-a-long-random-pairing-password
WAHA_DASHBOARD_ENABLED=false
WHATSAPP_SWAGGER_ENABLED=false
WAHA_WORKER_RESTART_SESSIONS=true

WHATSAPP_HOOK_URL=https://YOUR-CODEPLAY-DOMAIN/waha/webhook
WHATSAPP_HOOK_EVENTS=message,message.any
WHATSAPP_HOOK_HMAC_KEY=replace-with-the-same-value-as-WAHA_WEBHOOK_SECRET
WHATSAPP_HOOK_RETRIES_POLICY=exponential
WHATSAPP_HOOK_RETRIES_DELAY_SECONDS=2
WHATSAPP_HOOK_RETRIES_ATTEMPTS=8

WHATSAPP_PUBLIC_NUMBER=234XXXXXXXXXX
WHATSAPP_GAME_LINK_SECRET=replace-with-a-long-random-secret

MONGODB_URI=
MONGODB_DB=codeplay

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type Web).
# Add your Vercel domain under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Versus / chips
VERSUS_GAMES=ludo,whot,chess # games open for versus
VERSUS_CHESS_BASE=300        # chess versus clock: seconds per side
VERSUS_CHESS_INC=0           # chess versus increment (seconds)
VERSUS_FEE_RATE=0.10         # house fee taken from the pot
CHIPS_PER_USD=100
NEW_ACCOUNT_MAX_STAKE=1000   # stake cap (chips) for accounts younger than 24h
# TEST ONLY: lets signed-in players add free chips. Never enable once real deposits/withdrawals exist.
CHIPS_TEST_TOPUP=

# Crypto deposits (NOWPayments). Create an API key and an IPN secret in the NOWPayments dashboard.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=         # set to 1 to use api-sandbox.nowpayments.io while testing
DEPOSIT_MIN_USD=1
DEPOSIT_MAX_USD=500
# PUBLIC_BASE_URL must be the public address of this server (NOWPayments calls PUBLIC_BASE_URL/api/wallet/ipn)

# Friends
INVITE_TTL_MS=60000          # how long a friend invite stays open
TOURNAMENT_FORFEIT_MS=120000  # a player disconnected this long in a tournament match forfeits
