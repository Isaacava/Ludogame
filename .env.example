# Railway backend
PORT=3001
NODE_ENV=production

# Public URLs
SITE_URL=https://YOUR-VERCEL-DOMAIN
SITE_ORIGIN=https://YOUR-VERCEL-DOMAIN
PUBLIC_BASE_URL=https://YOUR-RAILWAY-DOMAIN
CORS_ORIGIN=https://YOUR-VERCEL-DOMAIN

# Admin
ADMIN_PASSWORD=replace-with-a-long-random-secret

# WAHA service (Railway private networking)
WAHA_URL=http://waha.railway.internal:3000
WAHA_SESSION=default
WAHA_WEBHOOK_SECRET=replace-with-a-random-shared-secret

# Optional official Twilio channel
TWILIO_AUTH_TOKEN=

# MongoDB Atlas persistence
MONGODB_URI=
MONGODB_DB=codeplay
