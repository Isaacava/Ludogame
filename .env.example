# Combined Railway service: CodePlay + WAHA
PORT=3000
NODE_ENV=production

# Public CodePlay URL (the Railway service domain)
SITE_URL=https://YOUR-CODEPLAY-DOMAIN
SITE_ORIGIN=https://YOUR-CODEPLAY-DOMAIN
PUBLIC_BASE_URL=https://YOUR-CODEPLAY-DOMAIN
CORS_ORIGIN=https://YOUR-CODEPLAY-DOMAIN

# Admin
ADMIN_PASSWORD=replace-with-a-long-random-secret

# WAHA runs beside CodePlay inside the same container.
# CodePlay listens on PORT=3000; WAHA listens internally on 3001.
WAHA_URL=http://127.0.0.1:3001
WAHA_API_PORT=3001
WAHA_SESSION=default
WHATSAPP_DEFAULT_ENGINE=GOWS
WAHA_API_KEY=replace-with-a-long-random-waha-api-key
WAHA_WEBHOOK_SECRET=replace-with-a-long-random-waha-webhook-hmac-secret
WAHA_PAIRING_PASSWORD=replace-with-a-long-random-pairing-password
WAHA_DASHBOARD_ENABLED=false
WHATSAPP_SWAGGER_ENABLED=false
WAHA_WORKER_RESTART_SESSIONS=true
WAHA_CLIENT_DEVICE_NAME=CodePlay
WAHA_CLIENT_BROWSER_NAME=Chrome

# WAHA -> CodePlay webhook. This stays inside the same Railway container.
WHATSAPP_HOOK_URL=http://127.0.0.1:3000/waha/webhook
WHATSAPP_HOOK_EVENTS=message
WHATSAPP_HOOK_HMAC_KEY=replace-with-the-same-value-as-WAHA_WEBHOOK_SECRET
WHATSAPP_HOOK_RETRIES_POLICY=exponential
WHATSAPP_HOOK_RETRIES_DELAY_SECONDS=2
WHATSAPP_HOOK_RETRIES_ATTEMPTS=8

# The WhatsApp number connected to the WAHA session, in international digits.
# Example: 2348012345678
WHATSAPP_PUBLIC_NUMBER=234XXXXXXXXXX

# Secret used to encrypt WhatsApp-to-game identity links; keep this private.
WHATSAPP_GAME_LINK_SECRET=replace-with-a-long-random-secret

# MongoDB Atlas persistence
MONGODB_URI=
MONGODB_DB=codeplay

# Legacy/optional official WhatsApp Cloud API integration.
# Not required for the WAHA deployment.
META_GRAPH_API_VERSION=v26.0
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
