# Railway backend
PORT=3001
NODE_ENV=production

# Public URLs
SITE_URL=https://YOUR-VERCEL-DOMAIN
SITE_ORIGIN=https://YOUR-VERCEL-DOMAIN
PUBLIC_BASE_URL=https://YOUR-RAILWAY-DOMAIN
CORS_ORIGIN=https://YOUR-VERCEL-DOMAIN

# Admin
ADMIN_PASSWORD=replace-with-a-long-random-secret

# WAHA service (Railway private networking)
WAHA_URL=http://waha.railway.internal:3000
WAHA_SESSION=default
WAHA_WEBHOOK_SECRET=replace-with-a-random-shared-secret

# Official WhatsApp Cloud API (Meta)
# Meta sends webhook verification requests to GET /whatsapp/meta.
META_GRAPH_API_VERSION=v26.0
META_WHATSAPP_VERIFY_TOKEN=replace-with-your-meta-webhook-verify-token
META_WHATSAPP_APP_SECRET=replace-with-your-meta-app-secret
META_WHATSAPP_ACCESS_TOKEN=replace-with-your-meta-system-user-access-token
META_WHATSAPP_PHONE_NUMBER_ID=replace-with-your-meta-phone-number-id
WHATSAPP_PUBLIC_NUMBER=+1234567890

# Optional official Twilio channel
TWILIO_AUTH_TOKEN=

# MongoDB Atlas persistence
MONGODB_URI=
MONGODB_DB=codeplay
